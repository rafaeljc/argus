# Local `prod`-profile run. Copy to `.env` (git-ignored) and fill in real vendor credentials.
#
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=prod

# --- Database -----------------------------------------------------------------------------------
# Matches docker-compose.yml at the repo root (`docker compose up -d` from there first).
ARGUS_DB_HOST=localhost
ARGUS_DB_PORT=5432
ARGUS_DB_NAME=argus
ARGUS_DB_USERNAME=argus
ARGUS_DB_PASSWORD=argus

# --- App ------------------------------------------------------------------------------------------
ARGUS_APP_BASE_URL=http://localhost:5173

# --- Admin ----------------------------------------------------------------------------------------
# The single administrator, named by the user id of an existing verified account. On startup that
# account is granted the admin flag and every other account loses it. `none` leaves whatever is in
# the database alone, which is what you want until you have signed up and verified a user to appoint.
ARGUS_ADMIN_USER_ID=none

# --- Web ------------------------------------------------------------------------------------------
# CORS + CSRF cookie posture for a deployment that splits the SPA and the API across two hosts.
# The origin the SPA is served from (used only when the API and SPA are cross-origin).
ARGUS_WEB_CORS_ALLOWED_ORIGIN=http://localhost:5173
# The registrable parent domain shared by both hosts (e.g. example.com for app.example.com and
# api.example.com), so the SPA can read the argus_csrf cookie. Left blank here: localhost has no
# such parent to share a cookie across.
ARGUS_WEB_COOKIE_DOMAIN=

# --- Email ----------------------------------------------------------------------------------------
# On the unverified-sender tier onboarding@resend.dev is the only address you may send from, and it
# only delivers to the address that owns the API key. Verify a domain to send anywhere else.
ARGUS_EMAIL_ADDRESS=onboarding@resend.dev
ARGUS_EMAIL_RESEND_API_URL=https://api.resend.com
# TODO: replace with your Resend key. A blank value fails the boot outright, so this
# placeholder is here only to let the app start — every send returns 401 until you swap it.
ARGUS_EMAIL_RESEND_API_KEY=replace_me

# --- Market data ------------------------------------------------------------------------------------
# TODO: no vendor account exists yet. Any non-blank value lets the app boot; calls fail until real.
ARGUS_MARKETDATA_MASSIVE_API_URL=https://api.massive.com
ARGUS_MARKETDATA_MASSIVE_API_KEY=replace_me

# --- Optional overrides ----------------------------------------------------------------------------
# Every property in application*.yaml is overridable by its matching environment variable (relaxed
# binding: property path uppercased, "." and "-" -> "_"). None of these need to be set — shown here
# with their effective defaults.
# ARGUS_EMAIL_VENDOR=noop
# ARGUS_EMAIL_POLL_INTERVAL_MS=30000
# ARGUS_MARKETDATA_BACKFILL_INTERVAL_MS=60000
# ARGUS_PORTFOLIO_SNAPSHOT_REBUILD_INTERVAL_MS=60000
# ARGUS_AUTH_SESSION_SWEEP_INTERVAL_MS=3600000
# ARGUS_EODPIPELINE_CRON=0 0 17 * * MON-FRI
# ARGUS_EODPIPELINE_ZONE=America/New_York
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# SPRING_TASK_SCHEDULING_POOL_SIZE=4
# SERVER_TOMCAT_THREADS_MAX=50
# LOGGING_LEVEL_IO_GITHUB_RAFAELJC_ARGUS=INFO
